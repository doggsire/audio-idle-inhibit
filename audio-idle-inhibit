#!/usr/bin/env bash
# Inhibits system sleep while audio is playing via systemd-inhibit.
# Screen dimming is handled by wayland-pipewire-idle-inhibit, which uses the
# standard Wayland zwp_idle_inhibit_manager_v1 protocol supported by Gamescope.

INHIBIT_PID=""
INHIBITED=0

is_audio_playing() {
    pactl list short sink-inputs 2>/dev/null | awk 'NF{c++} END{exit (c>0 ? 0 : 1)}'
}

start_inhibit() {
    systemd-inhibit \
        --what=sleep \
        --mode=block \
        --who=audio-idle-inhibit \
        --why="Audio playing" \
        sleep infinity &
    INHIBIT_PID=$!
    INHIBITED=1
}

stop_inhibit() {
    if [[ -n "$INHIBIT_PID" ]]; then
        kill "$INHIBIT_PID" 2>/dev/null || true
        wait "$INHIBIT_PID" 2>/dev/null || true
    fi
    INHIBIT_PID=""
    INHIBITED=0
}

while true; do
    if is_audio_playing; then
        [[ $INHIBITED -eq 0 ]] && start_inhibit
    else
        [[ $INHIBITED -eq 1 ]] && stop_inhibit
    fi
    sleep 1
done

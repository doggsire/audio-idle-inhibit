#!/usr/bin/env bash

INHIBIT_PID=""
INHIBITED=0
NUDGE_COUNTER=0
NUDGE_INTERVAL=30

is_audio_playing() {
    pactl list short sink-inputs 2>/dev/null | awk 'NF{c++} END{exit (c>0 ? 0 : 1)}'
}

# Gamescope (SteamOS Gaming Mode) does not respect systemd idle inhibitors for
# screen dimming. Injecting a 1-pixel mouse nudge resets its own idle timer.
# In games raw input mode is active so the X cursor position is irrelevant;
# in menus the 1-pixel snap-back is imperceptible.
nudge_display() {
    if command -v xdotool >/dev/null 2>&1; then
        xdotool mousemove_relative -- 1 0
        xdotool mousemove_relative -- -1 0
    fi
}

start_inhibit() {
    systemd-inhibit \
        --what=idle:sleep \
        --mode=block \
        --who=audio \
        --why="Audio playing" \
        sleep infinity &
    INHIBIT_PID=$!
    INHIBITED=1
    nudge_display
    NUDGE_COUNTER=0
}

stop_inhibit() {
    if [[ -n "$INHIBIT_PID" ]]; then
        kill "$INHIBIT_PID" 2>/dev/null || true
        wait "$INHIBIT_PID" 2>/dev/null || true
    fi
    INHIBIT_PID=""
    INHIBITED=0
    NUDGE_COUNTER=0
}

while true; do
    if is_audio_playing; then
        [[ $INHIBITED -eq 0 ]] && start_inhibit
        NUDGE_COUNTER=$((NUDGE_COUNTER + 1))
        if [[ $NUDGE_COUNTER -ge $NUDGE_INTERVAL ]]; then
            nudge_display
            NUDGE_COUNTER=0
        fi
    else
        [[ $INHIBITED -eq 1 ]] && stop_inhibit
    fi
    sleep 1
done

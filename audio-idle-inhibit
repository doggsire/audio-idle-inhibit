#!/usr/bin/env bash

INHIBIT_PID=""
INHIBITED=0
SCREENSAVER_COOKIE=""

is_audio_playing() {
    pactl list short sink-inputs 2>/dev/null | awk 'NF{c++} END{exit (c>0 ? 0 : 1)}'
}

start_inhibit() {
    systemd-inhibit \
        --what=idle:sleep \
        --mode=block \
        --who=audio \
        --why="Audio playing" \
        sleep infinity &
    INHIBIT_PID=$!
    SCREENSAVER_COOKIE=$(dbus-send --session --dest=org.freedesktop.ScreenSaver \
        --type=method_call --print-reply \
        /org/freedesktop/ScreenSaver org.freedesktop.ScreenSaver.Inhibit \
        string:"audio-idle-inhibit" string:"Audio playing" 2>/dev/null \
        | awk '/uint32/ {print $2}')
    INHIBITED=1
}

stop_inhibit() {
    if [[ -n "$INHIBIT_PID" ]]; then
        kill "$INHIBIT_PID" 2>/dev/null || true
        wait "$INHIBIT_PID" 2>/dev/null || true
    fi
    if [[ -n "$SCREENSAVER_COOKIE" ]]; then
        dbus-send --session --dest=org.freedesktop.ScreenSaver \
            --type=method_call \
            /org/freedesktop/ScreenSaver org.freedesktop.ScreenSaver.UnInhibit \
            uint32:"$SCREENSAVER_COOKIE" 2>/dev/null || true
    fi
    INHIBIT_PID=""
    SCREENSAVER_COOKIE=""
    INHIBITED=0
}

while true; do
    if is_audio_playing; then
        [[ $INHIBITED -eq 0 ]] && start_inhibit
    else
        [[ $INHIBITED -eq 1 ]] && stop_inhibit
    fi
    sleep 1
done

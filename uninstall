#!/usr/bin/env bash
set -euo pipefail

SERVICE_DIR="${HOME}/.config/systemd/user"

SLEEP_SERVICE="audio-idle-inhibit.service"
SLEEP_SERVICE_PATH="${SERVICE_DIR}/${SLEEP_SERVICE}"
SLEEP_BIN_PATH="${HOME}/.local/bin/audio-idle-inhibit"

systemctl --user disable --now "$SLEEP_SERVICE" 2>/dev/null || true

rm -f "$SLEEP_SERVICE_PATH" "$SLEEP_BIN_PATH"

systemctl --user daemon-reload

echo "Uninstalled: $SLEEP_SERVICE_PATH"
echo "Uninstalled: $SLEEP_BIN_PATH"

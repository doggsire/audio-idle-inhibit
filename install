#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="${HOME}/.local/bin"
BIN_NAME="audio-idle-inhibit"
BIN_PATH="${BIN_DIR}/${BIN_NAME}"

SERVICE_DIR="${HOME}/.config/systemd/user"
SERVICE_NAME="audio-idle-inhibit.service"
SERVICE_PATH="${SERVICE_DIR}/${SERVICE_NAME}"

SCRIPT_URL="https://raw.githubusercontent.com/doggsire/audio-idle-inhibit/main/audio-idle-inhibit"

mkdir -p "$BIN_DIR" "$SERVICE_DIR"

curl -fsSL "$SCRIPT_URL" -o "$BIN_PATH"
chmod +x "$BIN_PATH"

cat > "$SERVICE_PATH" <<'EOF'
[Unit]
Description=Idle inhibit while audio is playing (Pulse/PipeWire)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/audio-idle-inhibit
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload
systemctl --user enable --now "$SERVICE_NAME"

echo "Installed: $BIN_PATH"
echo "Installed: $SERVICE_PATH"
systemctl --user --no-pager status "$SERVICE_NAME" || true
